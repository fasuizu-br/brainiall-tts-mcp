{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-29/server.schema.json",
  "name": "com.brainiall/tts",
  "description": "Hosted pay-per-use TTS: 54 neural voices, 9 languages incl. Brazilian Portuguese. $10 free credits.",
  "version": "1.0.0",
  "websiteUrl": "https://brainiall.com",
  "repository": {
    "url": "https://github.com/fasuizu-br/brainiall-tts-mcp",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://api.brainiall.com/mcp/tts/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer YOUR_BRAINIALL_API_KEY (get one at https://app.brainiall.com)",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
