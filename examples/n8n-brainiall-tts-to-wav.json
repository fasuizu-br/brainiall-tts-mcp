      "id": "566a2e62-f078-4ce5-a81a-e9c02d095bc1",
      "name": "Set text and voice"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.brainiall.com/v1/tts/synthesize",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "audio/wav"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            {
              "name": "text",
              "value": "={{ $json.text }}"
            },
            {
              "name": "voice",
              "value": "={{ $json.voice }}"
            },
            {
              "name": "speed",
              "value": "={{ $json.speed }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "speech"
            }
          },
          "timeout": 120000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -20,
        100
      ],
      "id": "3fbd23c4-33b1-47b4-8437-d6b019871b07",
      "name": "Generate WAV with Brainiall"
    },
    {
      "parameters": {
        "content": "## Configure the API key before the first run\n\nOpen **Generate WAV with Brainiall** and select a **Header Auth** credential. Set the header name to `Authorization` and the value to `Bearer YOUR_BRAINIALL_API_KEY`. Never paste the key into node parameters.\n\nCreate a key with welcome credits: https://app.brainiall.com?utm_source=github&utm_medium=n8n_workflow&utm_campaign=c7_tts_automation\n\nA successful run returns WAV audio in the binary property `speech`. Synthesis is metered at USD 0.008 per 1,000 characters.",
        "height": 360,
        "width": 430,
        "color": 5
      },
